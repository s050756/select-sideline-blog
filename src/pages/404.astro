---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This page is not on the Select Sideline blog."
  pathname="/404"
  robots="noindex,follow"
>
  <div class="post-page">
    <p class="kicker">404</p>
    <h1>Page not found</h1>
    <p class="lede">
      This page is not part of the Select Sideline blog. Return to the
      <a href="/">notes from the sideline</a>.
    </p>
  </div>
</BaseLayout>
