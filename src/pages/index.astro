---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, MEDIA, SITE_DESCRIPTION, SITE_TITLE, blogJsonLd, formatDate } from "../lib/site";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} pathname="/" jsonLd={blogJsonLd()}>
  <p class="kicker">Select Sideline</p>
  <figure class="media-frame hero">
    <img
      src={MEDIA.hero}
      alt="Youth football field at dusk, the Select Sideline blog hero."
      width="1920"
      height="1080"
    />
  </figure>
  <h1>Notes from the sideline</h1>
  <p class="lede">
    Select Sideline is a curated youth playbook for select-age 3rd through 8th grade teams.
    Easy to teach, roster next to play calling, offline, and free. The app is at
    <a href={APP_URL}>selectsideline.com</a>. This blog is the public story of why it exists
    and what is live.
  </p>
  <h2>Posts</h2>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="post-card" href={`/${post.id}`}>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
