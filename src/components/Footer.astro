---
import { APP_URL, FEEDBACK_EMAIL, SITE_NAME } from "../lib/site";

interface Props {
  pathname?: string;
}

const { pathname = "" } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-lead">A curated playbook for select and premier youth coaches.</p>
    <p>
      <a href={APP_URL}>Use the app</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href={`mailto:${FEEDBACK_EMAIL}`}>{FEEDBACK_EMAIL}</a>
    </p>
    <p class="footer-legal">
      <a href="/privacy" aria-current={pathname === "/privacy" ? "page" : undefined}>Privacy</a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a href="/terms" aria-current={pathname === "/terms" ? "page" : undefined}>Terms</a>
    </p>
    <p class="footer-copy">© {year} {SITE_NAME}</p>
  </div>
</footer>
