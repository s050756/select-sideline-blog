---
import { APP_URL, SITE_NAME } from "../lib/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const onHome = pathname === "/";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-current={onHome ? "page" : undefined}>{SITE_NAME}</a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={onHome ? "page" : undefined}>Blog</a>
      <a class="app-link" href={APP_URL}>Open the app</a>
    </nav>
  </div>
</header>
