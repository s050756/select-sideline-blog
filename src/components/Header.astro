---
import { SITE_NAME } from "../lib/site";
import ProductCta from "./ProductCta.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const onHome = pathname === "/";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-current={onHome ? "page" : undefined}>
      <img class="brand-mark" src="/icon-512.png" alt="" width="32" height="32" />
      <span class="brand-name">{SITE_NAME}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a class="nav-link" href="/" aria-current={onHome ? "page" : undefined}>Blog</a>
      <ProductCta />
    </nav>
  </div>
</header>
