---
import { MEDIA, SITE_NAME } from "../lib/site";
import ProductCta from "./ProductCta.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const onHome = pathname === "/";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-current={onHome ? "page" : undefined}>
      <img class="brand-mark" src={MEDIA.mark} alt="" width="128" height="128" />
      {SITE_NAME}
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={onHome ? "page" : undefined}>Blog</a>
      <ProductCta />
    </nav>
  </div>
</header>
