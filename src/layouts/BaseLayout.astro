---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  APP_URL,
  CANONICAL_ORIGIN,
  OG_IMAGE_PATH,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  THEME_COLOR,
  absoluteUrl,
  canonicalUrl,
} from "../lib/site";

interface Props {
  title: string;
  description?: string;
  pathname: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  pathname,
  jsonLd,
  robots = "index,follow",
} = Astro.props;

const canonical = canonicalUrl(pathname);
const ogImage = absoluteUrl(OG_IMAGE_PATH);
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_NAME}`;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={pathname === "/" ? "website" : "article"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Select Sideline Blog on a football field. blog.selectsideline.com" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Select Sideline Blog on a football field. blog.selectsideline.com" />

    <link rel="alternate" href={CANONICAL_ORIGIN} />
    <link rel="related" href={APP_URL} title="Select Sideline app" />

    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header pathname={pathname} />
    <main id="content">
      <slot name="banner" />
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer pathname={pathname} />
  </body>
</html>
