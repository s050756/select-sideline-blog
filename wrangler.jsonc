{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "select-sideline-blog",
  // Assets-only Worker. No Worker script, no paid bindings.
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "blog.selectsideline.com",
      "custom_domain": true,
    },
  ],
}
